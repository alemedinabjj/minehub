{
  "name": "@hubmine/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist --enable-source-maps --env-file-if-exists=../../.env dist/main.js)",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hubmine/config": "workspace:*",
    "@hubmine/database": "workspace:*",
    "@hubmine/queue": "workspace:*",
    "@hubmine/shared": "workspace:*",
    "bullmq": "^6.3.11",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxlint": "^1.86.0",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
