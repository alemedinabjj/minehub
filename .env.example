# Copy is generated by scripts/dev-env.sh with random secrets. Shape reference only.
NODE_ENV=development
LOG_LEVEL=debug
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
DATABASE_URL=postgresql://hubmine:change-me@127.0.0.1:5432/hubmine?schema=public
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
JWT_ACCESS_SECRET=at-least-32-random-characters-here
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
SECRETS_ENCRYPTION_KEY=base64-of-32-random-bytes
NODE_NAME=local
DOCKER_SOCKET_PATH=/var/run/docker.sock
MC_IMAGE=itzg/minecraft-server:java21
MC_PUBLIC_HOST=localhost
MC_BIND_IP=0.0.0.0
MC_PORT_RANGE=25565-25664
MC_UID=1000
MC_GID=1000
NODE_SAFE_RATIO=0.85
# Dev override: allow a daemon without userns-remap (never in production).
DOCKER_REQUIRE_USERNS=true
